<% layout("/layouts/boilerplate") %>

    <script>

        const listingLocation = JSON.parse(
            '<%- JSON.stringify(listing.location) %>'
        );

        const listingTitle = JSON.parse(
            '<%- JSON.stringify(listing.title) %>'
        );

    </script>

    <style>
        /* Page */
        .show-container {
            padding: 1.5rem 1rem;
        }

        /* Main Card */
        .show-card {
            border: none !important;

            border-radius: 1.3rem !important;

            overflow: hidden;

            box-shadow: 0 6px 25px rgba(0, 0, 0, 0.08);
        }

        /* Main Image */
        .show-img {
            height: 55vh;

            width: 100%;

            object-fit: cover;
        }

        /* Card Body */
        .show-card .card-body {
            padding: 1.8rem;
        }

        /* Title */
        .listing-title {
            font-weight: 700;

            font-size: 2rem;
        }

        /* Listing Details */
        .listing-info p {
            margin-bottom: 0.7rem;

            font-size: 1rem;
        }

        /* Price */
        .listing-price {
            font-size: 1.3rem;

            font-weight: 700;

            color: #fe424d;
        }

        /* Buttons */
        .btns {
            display: flex;

            gap: 1rem;

            flex-wrap: wrap;
        }

        .btns a,
        .btns button {
            min-width: 120px;

            border-radius: 0.8rem;
        }

        /* Reviews */
        .review-card {
            border: none;

            border-radius: 1rem;

            box-shadow: 0 3px 15px rgba(0, 0, 0, 0.06);

            transition: 0.2s ease;
        }

        .review-card:hover {
            transform: translateY(-3px);
        }

        /* Review Form */
        textarea.form-control {
            border-radius: 1rem;

            resize: vertical;
        }

        /* Map */
        #map {
            height: 420px;

            width: 100%;

            border-radius: 1rem;

            overflow: hidden;

            margin-top: 1rem;

            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        }

        /* Section Headings */
        .section-title {
            font-weight: 700;

            margin-bottom: 1rem;
        }

        /* Mobile */
        @media (max-width: 768px) {

            .show-container {
                padding: 1rem 0.5rem;
            }

            .listing-title {
                font-size: 1.6rem;
            }

            .show-img {
                height: 35vh;
            }

            .show-card .card-body {
                padding: 1.2rem;
            }

            .btns {
                flex-direction: column;
            }

            .btns a,
            .btns button {
                width: 100%;
            }

            #map {
                height: 300px;
            }

            .listing-info p {
                font-size: 0.95rem;
            }
        }
    </style>


    <div class="container show-container">

        <!-- Title -->
        <div class="row">

            <div class="col-lg-8 mx-auto">

                <h1 class="listing-title mb-3">
                    <%= listing.title %>
                </h1>

            </div>

        </div>


        <!-- Main Listing Card -->
        <div class="row">

            <div class="col-lg-8 mx-auto">

                <div class="card show-card">

                    <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">

                    <div class="card-body">

                        <div class="listing-info">

                            <p>
                                Hosted by
                                <b>
                                    <%= listing.owner.username %>
                                </b>
                            </p>

                            <p>
                                <%= listing.description %>
                            </p>

                            <p class="listing-price">
                                ₹ <%= listing.price.toLocaleString("en-IN") %>
                            </p>

                            <p>
                                📍 <%= listing.location %>,
                                    <%= listing.country %>
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Owner Actions -->
        <% if(currUser && listing.owner._id.equals(currUser._id)) { %>

            <div class="row mt-3">

                <div class="col-lg-8 mx-auto">

                    <div class="btns">

                        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">

                            Edit

                        </a>

                        <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">

                            <button class="btn btn-danger">

                                Delete

                            </button>

                        </form>

                    </div>

                </div>

            </div>

            <% } %>


                <!-- Review Form -->
                <div class="row mt-5">

                    <div class="col-lg-8 mx-auto">

                        <hr>

                        <% if(currUser) { %>

                            <h3 class="section-title">
                                Leave a Review
                            </h3>

                            <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate
                                class="needs-validation">

                                <!-- Rating -->
                                <div class="mb-3">

                                    <label class="form-label">
                                        Rating
                                    </label>

                                    <fieldset class="starability-slot">

                                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]"
                                            value="1" checked aria-label="No rating." />

                                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                        <label for="first-rate1">1 star</label>

                                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                        <label for="first-rate2">2 stars</label>

                                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                        <label for="first-rate3">3 stars</label>

                                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                        <label for="first-rate4">4 stars</label>

                                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                        <label for="first-rate5">5 stars</label>

                                    </fieldset>

                                </div>


                                <!-- Comment -->
                                <div class="mb-3">

                                    <label for="comment" class="form-label">
                                        Comments
                                    </label>

                                    <textarea name="review[comment]" id="comment" rows="5" class="form-control"
                                        required></textarea>

                                </div>

                                <button class="btn btn-outline-dark rounded-pill px-4">

                                    Submit Review

                                </button>

                            </form>

                            <% } %>


                                <!-- Reviews -->
                                <% if(listing.reviews.length> 0) { %>

                                    <hr class="mt-5">

                                    <h3 class="section-title">
                                        Guest Reviews
                                    </h3>

                                    <div class="row">

                                        <% for(review of listing.reviews) { %>

                                            <div class="col-md-6 mb-4">

                                                <div class="card review-card h-100">

                                                    <div class="card-body">

                                                        <h5 class="card-title">
                                                            @<%= review.author.username %>
                                                        </h5>

                                                        <p class="starability-result"
                                                            data-rating="<%= review.rating %>">
                                                        </p>

                                                        <p class="card-text">
                                                            <%= review.comment %>
                                                        </p>

                                                    </div>

                                                    <form
                                                        action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                                        class="ms-3 mb-3" method="post">

                                                        <button class="btn btn-sm btn-outline-dark rounded-pill">

                                                            Delete

                                                        </button>

                                                    </form>

                                                </div>

                                            </div>

                                            <% } %>

                                    </div>

                                    <% } %>

                    </div>

                </div>


                <!-- Map -->
                <div class="row mt-5 mb-4">

                    <div class="col-lg-8 mx-auto">

                        <h3 class="section-title">
                            Where you'll be
                        </h3>

                        <div id="map"></div>

                    </div>

                </div>

    </div>


    <script src="/js/map.js"></script>